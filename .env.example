# Server
PORT=3080
HOST=127.0.0.1
NODE_ENV=development
ADMIN_PASSWORD=admin2026

# Supabase (Dashboard → Project Settings → API)
# 앱 서버는 SECRET(또는 SERVICE_ROLE)이 있어야 db:supabase 로 동작합니다.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# 레거시/별칭 (위와 동일 의미 — env.js에서 인식)
# SUPABASE_ANON_KEY=your_anon_or_publishable_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_secret_key
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: CLI link용 프로젝트 ref
# SUPABASE_PROJECT_REF=your_project_ref

# 주간 레포트 금주 요약·차주 계획 초안 (Gemini)
# 모델은 gemini-3.5-flash-lite 입니다. 키가 없으면 과제 내용을 모아 초안을 만듭니다.
# GEMINI_API_KEY=your_gemini_api_key

# Postgres (Transaction pooler — CLI/psql 전용, Express는 미사용)
# Dashboard → Database → Connect → Transaction pooler
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=postgres.YOUR_PROJECT_REF
# DB_PASSWORD=your_db_password
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:your_db_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# --- Production (Vercel / Render / Railway / Docker) 예시 ---
# NODE_ENV=production
# HOST=0.0.0.0          # Render/Docker용. Vercel은 불필요
# PORT=10000
# Vercel: Project Settings → Environment Variables 에
#   SUPABASE_URL, SUPABASE_SECRET_KEY, ADMIN_PASSWORD 등록 (JSON 폴백 불가)
