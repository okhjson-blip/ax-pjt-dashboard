{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "regions": ["sin1"],
  "services": {
    "ax-pjt-dashboard": {
      "root": ".",
      "framework": "express",
      "entrypoint": "app.js",
      "functions": {
        "app.js": {
          "includeFiles": "backend/**",
          "maxDuration": 300
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "ax-pjt-dashboard"
      }
    }
  ]
}
